{
  "name": "@khpayment/node",
  "version": "1.0.1",
  "description": "Server-side Node.js and TypeScript client for the KHPayment merchant-link integration API.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^22.23.3 || ^24.21.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "homepage": "https://khpayment.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ychetra/khpayment-tools.git",
    "directory": "packages/node"
  },
  "keywords": [
    "khpayment",
    "khqr",
    "cambodia",
    "payments",
    "payment-integration",
    "nodejs",
    "typescript",
    "sdk",
    "webhooks"
  ]
}
